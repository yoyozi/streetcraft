// prisma/schema.prisma — Single source of truth for database shape
// Migrated from MongoDB/Mongoose models to PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// NextAuth required tables (for @auth/prisma-adapter)
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  createdAt DateTime @default(now())

  @@unique([identifier, token])
  @@index([expires])
}

// ============================================================
// Application models
// ============================================================

model User {
  id                   String    @id @default(cuid())
  name                 String    @default("NO_NAME")
  email                String    @unique
  emailVerified        DateTime?
  password             String?
  image                String?
  role                 String    @default("user")
  isActive             Boolean   @default(true)
  requirePasswordReset Boolean   @default(false)
  passwordSetupToken   String?   @unique
  phoneNumber          String?   @unique
  resetToken           String?   @unique
  resetTokenExpires    DateTime?
  address              Json?
  paymentMethod        String?
  crafterId            String?

  // Relations
  accounts     Account[]
  sessions     Session[]
  crafterProfile Crafter?
  orders       Order[]
  reviews      Review[]
  carts        Cart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([crafterId])
  @@index([phoneNumber])
}

enum CrafterStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model Crafter {
  id               String        @id @default(cuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName     String
  description      String?
  location         String
  mobile           String
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id])
  whatsappNumber   String?
  city             String?
  province         String?
  profileImage     String?
  workSamples      String[]      @default([])

  status           CrafterStatus @default(PENDING)
  identityVerified Boolean       @default(false)
  isActive         Boolean       @default(true)

  approvedAt       DateTime?
  rejectedReason   String?

  // Relations
  products Product[]
  imageUploads ProductImageUpload[]
  payments CrafterPayment[]
  payouts CrafterPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([isActive])
  @@index([mobile])
}

model CrafterInvite {
  id           String    @id @default(cuid())
  mobile       String    @unique
  name         String
  inviteCode   String    @unique
  status       String    @default("PENDING") // PENDING, REGISTERED, EXPIRED
  smsSentAt    DateTime?
  registeredAt DateTime?
  createdBy    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mobile])
  @@index([status])
}

model Otp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([phone, code])
  @@index([expiresAt])
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String
  isActive    Boolean @default(true)

  crafters            Crafter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Product {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  category            String
  images              String[]
  description         String
  price               Float     @default(0)
  costPrice           Float     @default(0)
  priceNeedsReview    Boolean   @default(false)
  reviewReason        String?
  lastCostPriceUpdate DateTime?
  weight              Float     @default(0)
  height              Float     @default(0)
  width               Float     @default(0)
  depth               Float     @default(0)
  availability        Int       @default(3)
  rating              Float     @default(0)
  numReviews          Int       @default(0)
  isFirstPage         Boolean   @default(false)
  isUnique            Boolean   @default(false)
  isActive            Boolean   @default(true)
  banner              String?
  tags                String[]

  // Relations
  crafterId  String?
  crafter    Crafter?    @relation(fields: [crafterId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  reviews    Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isFirstPage])
  @@index([crafterId])
  @@index([isActive])
}

enum ProductImageUploadStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductImageUpload {
  id          String                    @id @default(cuid())
  crafterId   String
  crafter     Crafter                   @relation(fields: [crafterId], references: [id], onDelete: Cascade)
  imageUrl    String
  status      ProductImageUploadStatus  @default(PENDING)
  rejectionReason String?
  reviewedBy  String?
  reviewedAt  DateTime?
  
  // Product fields for crafter to fill in
  name        String?
  costPrice   Float?
  weight      Float?
  height      Float?
  width       Float?
  depth       Float?
  availability Int?
  description String?
  isUnique    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([crafterId])
  @@index([status])
  @@index([createdAt])
}

model Cart {
  id            String     @id @default(cuid())
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionCartId String
  items         CartItem[]
  itemsPrice    Float      @default(0)
  totalPrice    Float      @default(0)
  shippingPrice Float      @default(0)
  taxPrice      Float      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionCartId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  cart      Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  name      String
  slug      String
  qty       Int
  image     String
  price     Float

  @@unique([cartId, productId])
  @@index([cartId])
}

model Order {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  shippingAddress Json
  paymentMethod   String
  paymentResult   Json?
  itemsPrice      Float
  shippingPrice   Float
  taxPrice        Float
  totalPrice      Float
  totalPriceUsd   Float?
  exchangeRate    Float?
  eftEmailSent    Boolean   @default(false)
  eftEmailSentAt  DateTime?
  isPaid          Boolean   @default(false)
  paidAt          DateTime?
  isDelivered     Boolean   @default(false)
  deliveredAt     DateTime?

  // Relations
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isPaid])
  @@index([isDelivered])
  @@index([createdAt(sort: Desc)])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  price     Float
  name      String
  slug      String
  image     String

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
}

model Review {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  rating            Int
  title             String
  description       String
  isVerifiedPurchase Boolean @default(false)
  deliveredAt       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@index([createdAt(sort: Desc)])
}

// ============================================================
// Crafter Payment System
// ============================================================

model CrafterPayment {
  id           String   @id @default(cuid())
  crafterId    String
  crafter      Crafter  @relation(fields: [crafterId], references: [id], onDelete: Cascade)
  orderId      String
  orderItemId  String
  amount       Float
  status       String   @default("PENDING") // PENDING, PROCESSING, PAID, FAILED
  paymentDate  DateTime?
  paymentMethod String?
  reference    String?
  notes        String?

  payoutId     String?
  payout       CrafterPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([crafterId])
  @@index([status])
  @@index([orderId])
  @@index([payoutId])
}

model CrafterPayout {
  id            String   @id @default(cuid())
  crafterId     String
  crafter       Crafter  @relation(fields: [crafterId], references: [id], onDelete: Cascade)
  totalAmount   Float
  status        String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED
  paymentMethod String
  processedBy   String?
  processedAt   DateTime?
  reference     String?
  attachment    String?
  notes         String?

  payments      CrafterPayment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([crafterId])
  @@index([status])
}

// ============================================================
// Site Settings (key-value config)
// ============================================================

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
